{
  "name": "weebo",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "yarn expo start --offline",
    "build": "eas build --profile development --platform android",
    "buildi": "eas build --profile development --platform ios",
    "apple": "eas build -p ios --auto-submit",
    "droid": "eas build -p android --auto-submit",
    "off": "npx expo start --offline",
    "check": "npx expo install --check",
    "apk": "eas build --profile preview --platform android",
    "fix": "npx expo install --fix",
    "doc": "npx expo-doctor"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
